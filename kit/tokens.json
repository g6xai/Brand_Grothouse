{
  "name": "Grothouse Design System",
  "version": "2.0.0",
  "description": "Apple HIG token source for the Grothouse brand. Black/white/grey plus ONE accent per surface. Consume every value as a semantic token; a raw hex in a component is a violation.",
  "standard": {
    "canonical": "c:/Users/tony.grothouse/code/DriveX/design/APPLE-HIG-STANDARD.md",
    "localDeltas": "docs/APPLE-HIG-STANDARD.md",
    "precedence": "The canonical standard wins. Where this file and the canonical standard disagree, this file is the bug.",
    "adopted": "2026-08-12 (CEO ruling)",
    "supersedes": "1.0.0 — the retired four-axis matrix (accent, surface tone, glow level, and per-entity motion and radius overrides), the serif/sans/mono three-face split, and the radiance primitives."
  },

  "color": {
    "note": "Two accents, no more. Contrast ratios are measured by scripts/contrast.mjs against the surfaces in this file, not asserted. Re-run it before changing any value here.",
    "accent": {
      "blue": {
        "name": "Co-Operate Blue",
        "scope": "Grothouse default, platforms, websites, logos",
        "dark": "#5F7FFF",
        "light": "#1249E5",
        "contrast": {
          "dark on darkBg": 5.59,
          "dark on darkCard": 5.13,
          "light on lightBg": 6.2,
          "light on lightCard": 6.75,
          "white on light": 6.75
        }
      },
      "teal": {
        "name": "Xperience Teal",
        "scope": "G26xM, Xperience, Zeus, consumer-facing surfaces",
        "dark": "#14C8A6",
        "light": "#0E8C74",
        "lightText": "#0B7A64",
        "contrast": {
          "dark on darkBg": 9.22,
          "dark on darkCard": 8.47,
          "light on lightBg": 3.84,
          "light on lightCard": 4.18,
          "lightText on lightBg": 4.84,
          "lightText on lightCard": 5.27,
          "white on lightText": 5.27
        },
        "constraint": "#0E8C74 measures 3.84:1 on the light background. That clears the 3:1 bar for UI boundaries, focus rings and text at 22px+, and FAILS the 4.5:1 bar for body text. Accent-coloured text below 22px and filled-button labels use lightText #0B7A64. The accent hex itself is fixed by the colour law and ships today in @g6xai/brand v2.1.0, so it is kept rather than forked."
      }
    },
    "light": {
      "bg": "#F5F5F7",
      "card": "#FFFFFF",
      "sunken": "#EBEBEF",
      "ink": "#1D1D1F",
      "secondary": "#6E6E73",
      "border": "#D2D2D7",
      "material": "rgba(245,245,247,0.72)",
      "materialBorder": "rgba(29,29,31,0.08)",
      "contrast": {
        "ink on bg": 15.46,
        "ink on card": 16.83,
        "secondary on bg": 4.66,
        "secondary on card": 5.07
      }
    },
    "dark": {
      "bg": "#0B0B0D",
      "card": "#161618",
      "sunken": "#08080A",
      "ink": "#F5F5F7",
      "secondary": "#98989D",
      "border": "#2C2C2E",
      "material": "rgba(22,22,24,0.72)",
      "materialBorder": "rgba(255,255,255,0.07)",
      "contrast": {
        "ink on bg": 18.06,
        "ink on card": 16.6,
        "secondary on bg": 6.85,
        "secondary on card": 6.29
      }
    },
    "status": {
      "note": "Status only, never decoration. A status that needs a colour needs a token; do not reach for a palette class.",
      "success": { "light": "#1E7A47", "dark": "#3DD68C" },
      "warning": { "light": "#8A5A00", "dark": "#E0B341" },
      "error": { "light": "#B3261E", "dark": "#E5736B" }
    }
  },

  "type": {
    "note": "One family, five sizes. 12px is the hard floor. Sentence case only — measured on apple.com: zero uppercase-transformed elements and zero above 0.1em tracking across four page/viewport combinations.",
    "family": {
      "system": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', 'Segoe UI', system-ui, sans-serif",
      "id": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace"
    },
    "idUsage": "Monospace survives ONLY for machine identifiers where character alignment carries meaning — NMLS numbers, loan IDs, hash digests, API key prefixes. It is not a decorative treatment.",
    "scale": {
      "display": { "size": 34, "line": 1.15, "weight": 700, "role": "one per page maximum, page title only" },
      "title1": { "size": 28, "line": 1.2, "weight": 700, "role": "major section heading" },
      "title2": { "size": 22, "line": 1.27, "weight": 600, "role": "card heading, sheet title" },
      "body": { "size": 17, "line": 1.47, "weight": 400, "role": "DEFAULT — body copy, table cells, inputs, buttons" },
      "caption": { "size": 13, "line": 1.38, "weight": 400, "role": "metadata, column labels, helper text" }
    },
    "weightNote": "Apple leans on 600 far more than 400 (measured: 17px/600 is the single most common pairing on apple.com's home page). Treat semibold as the default for labels and titles, not as emphasis.",
    "floor": 12
  },

  "radius": {
    "note": "Two values plus pills. Apple's own buttons measure 980px radius, so buttons are pills; inputs and selects stay at 12px.",
    "control": 12,
    "card": 16,
    "pill": 9999
  },

  "motion": {
    "note": "prefers-reduced-motion must zero all of it.",
    "fast": 150,
    "standard": 250,
    "emphasis": 350,
    "ease": "cubic-bezier(0.32, 0.72, 0, 1)"
  },

  "space": {
    "note": "8pt grid, seven values. Every Tailwind half-step is banned.",
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32,
    "12": 48
  },

  "layout": {
    "containerPadding": { "mobile": 16, "tablet": 24, "desktop": 24 },
    "maxWidth": 1200,
    "prose": "65ch",
    "tapTarget": { "coarsePointer": 44, "finePointerDesktop": 32, "minGap": 8 }
  },

